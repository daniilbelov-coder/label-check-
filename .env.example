# Replicate API Configuration
# Get your API token from: https://replicate.com/account/api-tokens
# Copy this file to .env.local and add your actual token
REPLICATE_API_KEY=your_replicate_token_here

# Yandex Cloud API Configuration
# Get your API key from: https://console.cloud.yandex.ru/iam
# Get your folder ID from: https://console.cloud.yandex.ru/cloud
YANDEX_CLOUD_API_KEY=your_yandex_api_key_here
YANDEX_CLOUD_FOLDER=your_yandex_folder_id_here

# Optional: Server port (defaults to 3000)
# PORT=3000
